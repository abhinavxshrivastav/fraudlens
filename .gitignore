# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environments ---
.venv/
venv/
env/
.env
.env.*
!.env.example

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Data (raw datasets are NOT committed) ---
data/*
!data/sample/
!data/sample/**
!data/.gitkeep

# --- Model artefacts (tracked via Git LFS in artifacts/, see .gitattributes) ---
artifacts/**/*.pkl
artifacts/**/*.joblib
artifacts/**/*.txt
!artifacts/**/*.json
!artifacts/**/.gitkeep

# --- Local runtime state ---
*.duckdb
*.duckdb.wal
*.db
*.sqlite3
logs/
.fraudlens/

# --- Node / frontend ---
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
playwright-report/
test-results/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
