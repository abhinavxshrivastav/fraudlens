# ---------------------------------------------------------------------------
# FraudLens configuration. Copy to `.env` and adjust. All values have safe
# defaults in src/fraudlens/config/settings.py -- nothing here is required.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
FRAUDLENS_ENV=local                 # local | docker | production
FRAUDLENS_LOG_LEVEL=INFO
FRAUDLENS_LOG_JSON=false            # true emits structured JSON logs

# Paths ---------------------------------------------------------------------
FRAUDLENS_DATA_DIR=data
FRAUDLENS_ARTIFACT_DIR=artifacts

# Infrastructure profile ----------------------------------------------------
# native  -> in-process broker + DuckDB feature store (no Docker required)
# docker  -> Kafka broker + Redis feature store (requires docker compose up)
FRAUDLENS_PROFILE=native
FRAUDLENS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FRAUDLENS_REDIS_URL=redis://localhost:6379/0

# Serving -------------------------------------------------------------------
FRAUDLENS_API_HOST=0.0.0.0
FRAUDLENS_API_PORT=8000
FRAUDLENS_CORS_ORIGINS=http://localhost:5173

# Demo mode: seed the store and start the replay producer on boot ------------
FRAUDLENS_DEMO_MODE=false
FRAUDLENS_REPLAY_SPEED=60           # multiplier vs. real time

# Kaggle (only needed to download the full dataset) -------------------------
# KAGGLE_USERNAME=
# KAGGLE_KEY=
